<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Manag Shop — интернет-магазин</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
        }
        body {
            background: #f7f9fc;
            color: #1e2a3e;
        }
        /* Header */
        .header {
            background: #ffffff;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            position: sticky;
            top: 0;
            z-index: 100;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }
        .logo {
            font-size: 1.8rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            background: linear-gradient(135deg, #2b5c6f, #1e3b4a);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        .cart-icon {
            position: relative;
            cursor: pointer;
            background: #2b5c6f;
            color: white;
            padding: 0.5rem 1.2rem;
            border-radius: 40px;
            font-weight: 600;
            transition: 0.2s;
            border: none;
            font-size: 1rem;
        }
        .cart-icon:hover {
            background: #1e3b4a;
            transform: scale(1.02);
        }
        .cart-count {
            background: #e67e22;
            border-radius: 30px;
            padding: 0.2rem 0.6rem;
            font-size: 0.8rem;
            margin-left: 6px;
        }
        /* Container */
        .container {
            max-width: 1300px;
            margin: 2rem auto;
            padding: 0 1.5rem;
        }
        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 2rem;
        }
        .product-card {
            background: white;
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 12px 30px rgba(0,0,0,0.05);
            transition: all 0.2s ease;
            display: flex;
            flex-direction: column;
        }
        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 24px 40px rgba(0,0,0,0.1);
        }
        .product-img {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            background: #eef2f5;
        }
        .product-info {
            padding: 1.2rem;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }
        .product-title {
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }
        .product-price {
            font-size: 1.5rem;
            font-weight: 800;
            color: #2b5c6f;
            margin: 0.6rem 0;
        }
        .price-currency {
            font-size: 0.9rem;
            font-weight: 500;
        }
        .add-to-cart {
            background: #1e3b4a;
            border: none;
            color: white;
            padding: 0.8rem;
            border-radius: 60px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: 0.2s;
            margin-top: 0.6rem;
        }
        .add-to-cart:hover {
            background: #0e2a36;
        }
        /* Модальное окно корзины */
        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(3px);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }
        .modal-content {
            background: white;
            max-width: 550px;
            width: 90%;
            max-height: 85vh;
            border-radius: 32px;
            padding: 1.5rem;
            overflow-y: auto;
        }
        .cart-items {
            margin: 1rem 0;
            max-height: 300px;
            overflow-y: auto;
        }
        .cart-item {
            display: flex;
            justify-content: space-between;
            padding: 0.7rem 0;
            border-bottom: 1px solid #e2e8f0;
        }
        .total {
            font-weight: 800;
            font-size: 1.3rem;
            margin: 1rem 0;
        }
        input, textarea {
            width: 100%;
            padding: 0.8rem;
            margin: 0.5rem 0;
            border-radius: 20px;
            border: 1px solid #cbd5e1;
            font-size: 1rem;
        }
        .btn-primary {
            background: #2b5c6f;
            color: white;
            border: none;
            padding: 0.9rem;
            border-radius: 60px;
            font-weight: bold;
            width: 100%;
            cursor: pointer;
        }
        .close-modal {
            float: right;
            font-size: 1.7rem;
            cursor: pointer;
        }
        footer {
            text-align: center;
            padding: 2rem;
            color: #5e6f8d;
            margin-top: 2rem;
            border-top: 1px solid #e2edf2;
        }
        @media (max-width: 650px) {
            .header { padding: 1rem; }
            .logo { font-size: 1.4rem; }
        }
        .loading {
            text-align: center;
            padding: 3rem;
            font-size: 1.2rem;
        }
    </style>
</head>
<body>

<div class="header">
    <div class="logo">🛍️ MANAG SHOP</div>
    <button class="cart-icon" id="cartBtn">🛒 Корзина <span id="cartCount" class="cart-count">0</span></button>
</div>

<div class="container">
    <div id="productsContainer" class="products-grid">
        <div class="loading">Загрузка товаров из Google Таблицы...</div>
    </div>
</div>

<!-- Модалка корзины -->
<div id="cartModal" class="modal">
    <div class="modal-content">
        <span class="close-modal" id="closeModal">&times;</span>
        <h2>🛍️ Ваша корзина</h2>
        <div id="cartItemsList" class="cart-items">Корзина пуста</div>
        <div id="cartTotal" class="total">Итого: 0 ₽</div>
        <hr>
        <h3>Оформление заказа</h3>
        <input type="text" id="customerName" placeholder="Ваше имя" autocomplete="name">
        <input type="tel" id="customerPhone" placeholder="Телефон" autocomplete="tel">
        <textarea id="customerAddress" rows="2" placeholder="Адрес доставки"></textarea>
        <button id="submitOrderBtn" class="btn-primary">✅ Оформить заказ</button>
        <p id="orderMessage" style="margin-top: 0.8rem; font-size: 0.85rem; color: #2c7a4d;"></p>
    </div>
</div>

<footer>
    © 2025 Manag Shop — быстрая доставка
</footer>

<script>
    // --------------------------------------------------------------
    // 1. КОНФИГУРАЦИЯ (ЗАМЕНИТЕ НА СВОЮ ССЫЛКУ CSV ОТ GOOGLE TABLES)
    // --------------------------------------------------------------
    const GOOGLE_SHEETS_CSV_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vSwGPotzJeamZ1tLBwVR7fXd_C24k8ULjqIDZ-i8AJ_-23XOa6bggClh55Ws1_UCr-7hhPDXyYAK_xk/pub?output=csv";
    // 👆 ВСТАВЬТЕ ВАШУ РЕАЛЬНУЮ ССЫЛКУ (где output=csv)

    // Лист с заказами (Google Apps Script Webhook — добавим позже)
    // Для отправки заказов используем Google Forms / Apps Script (бесплатно).
    // Ниже будет функция отправки в таблицу "Заказы".
    // --------------------------------------------------------------

    let products = [];          // массив товаров
    let cart = [];             // { id, name, price, quantity }
    let isCartLoaded = false;

    // Загружаем корзину из localStorage
    function loadCartFromStorage() {
        const saved = localStorage.getItem("manag_shop_cart");
        if(saved) {
            try {
                cart = JSON.parse(saved);
                renderCartUI();
                updateCartCounter();
            } catch(e) {}
        }
    }
    function saveCartToStorage() {
        localStorage.setItem("manag_shop_cart", JSON.stringify(cart));
        updateCartCounter();
    }
    function updateCartCounter() {
        let totalItems = 0;
        cart.forEach(item => totalItems += item.quantity);
        document.getElementById("cartCount").innerText = totalItems;
    }

    // Отображение корзины в модалке
    function renderCartUI() {
        const container = document.getElementById("cartItemsList");
        const totalSpan = document.getElementById("cartTotal");
        if(!container) return;
        if(cart.length === 0) {
            container.innerHTML = "Корзина пуста 😢";
            totalSpan.innerText = "Итого: 0 ₽";
            return;
        }
        let html = "";
        let total = 0;
        cart.forEach((item, idx) => {
            const itemTotal = item.price * item.quantity;
            total += itemTotal;
            html += `
                <div class="cart-item">
                    <div><strong>${escapeHtml(item.name)}</strong><br>${item.price} ₽ × ${item.quantity}</div>
                    <div>${itemTotal} ₽ <button data-idx="${idx}" class="remove-item" style="background:#e67e22; border:none; color:white; border-radius:30px; padding:4px 12px; margin-left:10px;">✖</button></div>
                </div>
            `;
        });
        container.innerHTML = html;
        totalSpan.innerText = `Итого: ${total} ₽`;
        // навешиваем удаление
        document.querySelectorAll(".remove-item").forEach(btn => {
            btn.addEventListener("click", (e) => {
                const idx = parseInt(btn.getAttribute("data-idx"));
                if(!isNaN(idx)) {
                    cart.splice(idx,1);
                    saveCartToStorage();
                    renderCartUI();
                    if(typeof renderProducts === 'function') renderProducts(); // обновим кнопки
                    else location.reload();
                }
            });
        });
    }

    // Добавление в корзину
    function addToCart(product) {
        const existing = cart.find(item => item.id === product.id);
        if(existing) {
            existing.quantity += 1;
        } else {
            cart.push({
                id: product.id,
                name: product.name,
                price: product.price,
                quantity: 1
            });
        }
        saveCartToStorage();
        renderCartUI();
        alert(`✅ ${product.name} добавлен в корзину`);
    }

    // Функция отправки заказа в Google Таблицу (через Google Apps Script Web App)
    // ВАЖНО: нужно будет развернуть скрипт как веб-приложение, ссылку вставить ниже.
    // Временно (для теста) заказ будет выводиться в консоль и предложено скопировать.
    // Но мы сделаем полноценную отправку.
    const GOOGLE_APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbwUMnA40yAG6ChRuslDSSdDLLJtD-QX6IiGFg3PmAbpPzgkcByvEpTECQlhyukAiHU7KA/exec";  // Оставьте пустым, если не настроили, тогда просто покажем данные.
    
    async function sendOrderToGoogleSheets(orderData) {
        if(!GOOGLE_APPS_SCRIPT_URL) {
            console.log("Заказ (режим отладки):", orderData);
            alert("✅ Заказ принят! (демо-режим: данные не отправлены в Google Таблицу, но вы можете скопировать их из консоли браузера).\nЧтобы включить автоматическую запись — настройте Google Apps Script.");
            return false;
        }
        try {
            const response = await fetch(GOOGLE_APPS_SCRIPT_URL, {
                method: 'POST',
                mode: 'no-cors', // для простоты, но лучше использовать CORS-прокси
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(orderData)
            });
            return true;
        } catch(e) {
            console.error("Ошибка отправки", e);
            return false;
        }
    }

    // Оформление заказа
    async function placeOrder() {
        const name = document.getElementById("customerName").value.trim();
        const phone = document.getElementById("customerPhone").value.trim();
        const address = document.getElementById("customerAddress").value.trim();
        if(!name || !phone || !address) {
            alert("Пожалуйста, заполните имя, телефон и адрес доставки");
            return;
        }
        if(cart.length === 0) {
            alert("Корзина пуста");
            return;
        }
        let cartSummary = "";
        let totalOrder = 0;
        cart.forEach(item => {
            cartSummary += `${item.name} x${item.quantity} = ${item.price*item.quantity}₽\n`;
            totalOrder += item.price * item.quantity;
        });
        const orderObject = {
            name: name,
            phone: phone,
            address: address,
            items: cartSummary,
            total: totalOrder,
            date: new Date().toLocaleString()
        };
        const success = await sendOrderToGoogleSheets(orderObject);
        if(success || !GOOGLE_APPS_SCRIPT_URL) {
            alert(`Спасибо, ${name}! Ваш заказ на сумму ${totalOrder}₽ принят.\nНаш менеджер свяжется с вами.`);
            // очищаем корзину
            cart = [];
            saveCartToStorage();
            renderCartUI();
            updateCartCounter();
            document.getElementById("customerName").value = "";
            document.getElementById("customerPhone").value = "";
            document.getElementById("customerAddress").value = "";
            const modal = document.getElementById("cartModal");
            if(modal) modal.style.display = "none";
        } else {
            alert("Ошибка при отправке заказа. Попробуйте позже.");
        }
    }

    // Загрузка товаров из CSV (Google Sheets)
    async function fetchProductsFromSheet() {
        try {
            const response = await fetch(GOOGLE_SHEETS_CSV_URL);
            const csvText = await response.text();
            // Парсинг CSV вручную (простой)
            const rows = csvText.split(/\r?\n/);
            if(rows.length < 2) throw new Error("Нет данных");
            const headers = rows[0].split(',').map(h => h.replace(/^"|"$/g, '').trim());
            const idIdx = headers.findIndex(h => h.toLowerCase() === 'id');
            const nameIdx = headers.findIndex(h => h.toLowerCase() === 'название');
            const priceIdx = headers.findIndex(h => h.toLowerCase() === 'цена');
            const photoIdx = headers.findIndex(h => h.toLowerCase() === 'фото_url');
            const items = [];
            for(let i=1; i<rows.length; i++) {
                if(!rows[i].trim()) continue;
                const cols = rows[i].split(',').map(c => c.replace(/^"|"$/g, '').trim());
                if(cols.length < 4) continue;
                const id = cols[idIdx] || i;
                const name = cols[nameIdx] || "Товар";
                let price = parseFloat(cols[priceIdx]);
                if(isNaN(price)) price = 0;
                let photo = cols[photoIdx] || "https://fakeimg.pl/400x400/e0e7ef/7c8b9c?text=No+Image";
                if(!photo.startsWith("http")) photo = "https://fakeimg.pl/400x400/e0e7ef/7c8b9c?text=Product";
                items.push({ id, name, price, photo });
            }
            products = items;
            renderProducts();
        } catch(e) {
            console.error("Ошибка загрузки товаров:", e);
            document.getElementById("productsContainer").innerHTML = `<div style="color:red;">❌ Ошибка загрузки товаров из Google Таблицы. Проверьте ссылку CSV и права публикации.</div>`;
        }
    }

    // Отрисовка товаров на сайте
    function renderProducts() {
        const container = document.getElementById("productsContainer");
        if(!container) return;
        if(!products.length) {
            container.innerHTML = `<div>Нет товаров. Добавьте данные в Google Таблицу.</div>`;
            return;
        }
        let html = "";
        products.forEach(prod => {
            html += `
                <div class="product-card">
                    <img class="product-img" src="${escapeHtml(prod.photo)}" alt="${escapeHtml(prod.name)}" loading="lazy" onerror="this.src='https://fakeimg.pl/400x400/cccccc/909090?text=Image+Error'">
                    <div class="product-info">
                        <div class="product-title">${escapeHtml(prod.name)}</div>
                        <div class="product-price">${prod.price} <span class="price-currency">₽</span></div>
                        <button class="add-to-cart" data-id="${prod.id}" data-name="${escapeHtml(prod.name)}" data-price="${prod.price}">➕ В корзину</button>
                    </div>
                </div>
            `;
        });
        container.innerHTML = html;
        // навешиваем события
        document.querySelectorAll('.add-to-cart').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const id = btn.getAttribute('data-id');
                const name = btn.getAttribute('data-name');
                const price = parseFloat(btn.getAttribute('data-price'));
                addToCart({ id, name, price });
            });
        });
    }

    function escapeHtml(str) {
        if(!str) return '';
        return str.replace(/[&<>]/g, function(m) {
            if(m === '&') return '&amp;';
            if(m === '<') return '&lt;';
            if(m === '>') return '&gt;';
            return m;
        }).replace(/[\uD800-\uDBFF][\uDC00-\uDFFF]/g, function(c) {
            return c;
        });
    }

    // Модальные окна
    function initModal() {
        const modal = document.getElementById("cartModal");
        const cartBtn = document.getElementById("cartBtn");
        const closeSpan = document.getElementById("closeModal");
        cartBtn.onclick = () => { modal.style.display = "flex"; renderCartUI(); };
        closeSpan.onclick = () => { modal.style.display = "none"; };
        window.onclick = (e) => { if(e.target === modal) modal.style.display = "none"; };
        document.getElementById("submitOrderBtn").addEventListener("click", placeOrder);
    }

    // Запуск при загрузке
    window.addEventListener("DOMContentLoaded", () => {
        initModal();
        loadCartFromStorage();
        fetchProductsFromSheet();
    });
</script>
</body>
</html>
